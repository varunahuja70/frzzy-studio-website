# ==============================================================================
# FRZZY STUDIO WEBSITE — ENVIRONMENT CONFIGURATION
# Copy this file to `.env.local` for local development. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE INFRASTRUCTURE (Required for production database, RLS & Storage)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anonymous Key (safe to expose in client code, constrained by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (SERVER-ONLY: Bypass RLS for migrations/admin functions)
# ⚠️ NEVER expose this key to client-side code, git repositories, or frontend bundles
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. STUDIO VAULT & CRYPTOGRAPHY SECRETS
# ------------------------------------------------------------------------------
# 256-bit AES-GCM Encryption Key for PII (Must be exactly 64 hexadecimal characters)
ADMIN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Server Pepper for Argon2id Password Hashing
ADMIN_PEPPER="your-super-secret-server-pepper-value-here"

# HMAC Secret for Admin Session Cookie Signing
ADMIN_SESSION_SECRET="your-super-secret-session-signing-key-here"

# Secret for Signing Temporary Public Media / Showreel Tokens
MEDIA_SIGNING_SECRET="your-super-secret-media-signing-key-here"

# ------------------------------------------------------------------------------
# 3. PUBLIC WEBSITE CONFIGURATION
# ------------------------------------------------------------------------------
# Base Application URL (e.g. http://localhost:3000 or https://frzzy.studio)
APP_URL="http://localhost:3000"

# Optional Custom Admin Vault Route Path (defaults to 'studio-vault')
ADMIN_VAULT_PATH="studio-vault"

# Book-a-Call Page Calendly Embed URL (e.g. https://calendly.com/frzzy-studio/intro-call)
NEXT_PUBLIC_CALENDLY_URL=""

# Gemini AI API Key (Optional: for AI-enhanced studio generative tooling)
GEMINI_API_KEY=""
