# Copy to .env.local (development) or set in your host's environment settings (production).
# Never commit real values. Generate each secret with:  openssl rand -hex 32

# ---- Required in production: the server refuses to start without them ----
ADMIN_PASSWORD_PEPPER=
LEADS_ENCRYPTION_KEY=
MEDIA_SIGNING_SECRET=
ANALYTICS_SALT=

# Private URL of the admin area (the default "studio-vault" is public in this repo)
ADMIN_PATH=

# ---- Only while rotating a key: put the old value here so existing data keeps working ----
# PREVIOUS_ADMIN_PASSWORD_PEPPER=
# PREVIOUS_LEADS_ENCRYPTION_KEY=

# ---- Optional ----
# Number of reverse proxies you control in front of the app (Cloudflare + your proxy = 2)
# TRUSTED_PROXY_COUNT=1
# DATABASE_URL=file:/absolute/path/to/frxcx.db

APP_URL=
NEXT_PUBLIC_CALENDLY_URL=""
